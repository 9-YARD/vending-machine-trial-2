<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_vending_test"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- Auth status -->
    <TextView
        android:id="@+id/tv_auth_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/checking_auth"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Serial port label (hardcoded ttyS3) -->
    <TextView
        android:id="@+id/tv_serial_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/serial_port_label"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- Dispense buttons -->
    <Button
        android:id="@+id/btn_slot_36"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dispense_slot_36"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_slot_31"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dispense_slot_31"
        android:layout_marginBottom="16dp" />

    <!-- Last result -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/last_result_label"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:layout_marginBottom="12dp" />

    <!-- Live SDK event log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sdk_log_label"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EEEEEE">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:padding="8dp" />

    </ScrollView>

</LinearLayout>
